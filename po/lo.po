#: src/ui/theme.c:467
msgid "Frame geometry does not specify size of buttons"
msgstr "ເລຂາຄະນິດຂອງເຟຣມບໍ່ໄດ້ລະບຸຂະໜາດຂອງປຸ່ມ"

#: src/ui/theme.c:1227
msgid "Gradients should have at least two colors"
msgstr "ການໄລ່ສີຄວນມີຢ່າງໜ້ອຍສອງສີ"

#: src/ui/theme.c:1397
#, c-format
msgid ""
"GTK custom color specification must have color name and fallback in "
"parentheses, e.g. gtk:custom(foo,bar); could not parse \"%s\""
msgstr ""
"ການລະບຸສີກຳນົດເອງຂອງ GTK ຕ້ອງມີຊື່ສີ ແລະ ສີສຳຮອງໃນວົງເລັບ, ເຊັ່ນ: gtk:custom(foo,bar); ບໍ່ສາ"
"ມາດວິເຄາະ \"%s\""

#: src/ui/theme.c:1413
#, c-format
msgid ""
"Invalid character '%c' in color_name parameter of gtk:custom, only "
"A-Za-z0-9-_ are valid"
msgstr ""
"ຕົວອັກສອນ '%c' ບໍ່ຖືກຕ້ອງໃນພາຣາມິເຕີ color_name ຂອງ gtk:custom, ອະນຸຍາດສະເພາະ A-Za-z0-"
"9-_ ເທົ່ານັ້ນ"

#: src/ui/theme.c:1427
#, c-format
msgid ""
"Gtk:custom format is \"gtk:custom(color_name,fallback)\", \"%s\" does not "
"fit the format"
msgstr ""
"ຮູບແບບ Gtk:custom ແມ່ນ \"gtk:custom(color_name,fallback)\", \"%s\" ບໍ່ກົງກັບຮູບແບບ"

#: src/ui/theme.c:1471
#, c-format
msgid ""
"GTK color specification must have the state in brackets, e.g. gtk:fg[NORMAL]"
" where NORMAL is the state; could not parse \"%s\""
msgstr ""
"ການລະບຸສີ GTK ຕ້ອງມີສະຖານະໃນວົງເລັບຫຼ່ຽມ, ເຊັ່ນ: gtk:fg[NORMAL] ໂດຍທີ່ NORMAL ແມ່ນສະຖານະ; "
"ບໍ່ສາມາດວິເຄາະ \"%s\""

#: src/ui/theme.c:1485
#, c-format
msgid ""
"GTK color specification must have a close bracket after the state, e.g. "
"gtk:fg[NORMAL] where NORMAL is the state; could not parse \"%s\""
msgstr ""
"ການລະບຸສີ GTK ຕ້ອງມີວົງເລັບຫຼ່ຽມປິດຕາມຫຼັງສະຖານະ, ເຊັ່ນ: gtk:fg[NORMAL] ໂດຍທີ່ NORMAL ແມ່ນສະຖ"
"ານະ; ບໍ່ສາມາດວິເຄາະ \"%s\""

#: src/ui/theme.c:1496
#, c-format
msgid "Did not understand state \"%s\" in color specification"
msgstr "ບໍ່ເຂົ້າໃຈສະຖານະ \"%s\" ໃນການລະບຸສີ"

#: src/ui/theme.c:1509
#, c-format
msgid "Did not understand color component \"%s\" in color specification"
msgstr "ບໍ່ເຂົ້າໃຈສ່ວນປະກອບສີ \"%s\" ໃນການລະບຸສີ"

#: src/ui/theme.c:1537
#, c-format
msgid ""
"Blend format is \"blend/bg_color/fg_color/alpha\", \"%s\" does not fit the "
"format"
msgstr ""
"ຮູບແບບການປະສົມແມ່ນ \"blend/bg_color/fg_color/alpha\", \"%s\" ບໍ່ກົງກັບຮູບແບບ"

#: src/ui/theme.c:1548
#, c-format
msgid "Could not parse alpha value \"%s\" in blended color"
msgstr "ບໍ່ສາມາດວິເຄາະຄ່າອັນຟາ (alpha) \"%s\" ໃນສີທີ່ປະສົມ"

#: src/ui/theme.c:1558
#, c-format
msgid "Alpha value \"%s\" in blended color is not between 0.0 and 1.0"
msgstr "ຄ່າອັນຟາ \"%s\" ໃນສີທີ່ປະສົມ ບໍ່ໄດ້ຢູ່ລະຫວ່າງ 0.0 ແລະ 1.0"

#: src/ui/theme.c:1604
#, c-format
msgid "Shade format is \"shade/base_color/factor\", \"%s\" does not fit the format"
msgstr "ຮູບແບບເງົາແມ່ນ \"shade/base_color/factor\", \"%s\" ບໍ່ກົງກັບຮູບແບບ"

#: src/ui/theme.c:1615
#, c-format
msgid "Could not parse shade factor \"%s\" in shaded color"
msgstr "ບໍ່ສາມາດວິເຄາະຄ່າປັດໄຈເງົາ \"%s\" ໃນສີທີ່ມີເງົາ"

#: src/ui/theme.c:1625
#, c-format
msgid "Shade factor \"%s\" in shaded color is negative"
msgstr "ຄ່າປັດໄຈເງົາ \"%s\" ໃນສີທີ່ມີເງົາເປັນຄ່າລົບ"

#: src/ui/theme.c:1654
#, c-format
msgid "Could not parse color \"%s\""
msgstr "ບໍ່ສາມາດວິເຄາະສີ \"%s\""

#: src/ui/theme.c:2003
#, c-format
msgid "Coordinate expression contains character '%s' which is not allowed"
msgstr "ນິພົດພິກັດມີຕົວອັກສອນ '%s' ເຊິ່ງບໍ່ໄດ້ຮັບອະນຸຍາດ"

#: src/ui/theme.c:2030
#, c-format
msgid ""
"Coordinate expression contains floating point number '%s' which could not be"
" parsed"
msgstr "ນິພົດພິກັດມີຕົວເລກທົດສະນິຍົມ '%s' ເຊິ່ງບໍ່ສາມາດວິເຄາະໄດ້"

#: src/ui/theme.c:2044
#, c-format
msgid "Coordinate expression contains integer '%s' which could not be parsed"
msgstr "ນິພົດພິກັດມີຕົວເລກຖ້ວນ '%s' ເຊິ່ງບໍ່ສາມາດວິເຄາະໄດ້"

#: src/ui/theme.c:2166
#, c-format
msgid ""
"Coordinate expression contained unknown operator at the start of this text: "
"\"%s\""
msgstr "ນິພົດພິກັດມີຕົວດຳເນີນການທີ່ບໍ່ຮູ້ຈັກຢູ່ເລີ່ມຕົ້ນຂອງຂໍ້ຄວາມນີ້: \"%s\""

#: src/ui/theme.c:2223
msgid "Coordinate expression was empty or not understood"
msgstr "ນິພົດພິກັດວ່າງ ຫຼື ບໍ່ເຂົ້າໃຈ"

#: src/ui/theme.c:2334 src/ui/theme.c:2344 src/ui/theme.c:2378
msgid "Coordinate expression results in division by zero"
msgstr "ນິພົດພິກັດສົ່ງຜົນໃຫ້ເກີດການຫານດ້ວຍສູນ"

#: src/ui/theme.c:2386
msgid ""
"Coordinate expression tries to use mod operator on a floating-point number"
msgstr "ນິພົດພິກັດພະຍາຍາມໃຊ້ຕົວດຳເນີນການ mod ກັບຕົວເລກທົດສະນິຍົມ"

#: src/ui/theme.c:2442
#, c-format
msgid "Coordinate expression has an operator \"%s\" where an operand was expected"
msgstr "ນິພົດພິກັດມີຕົວດຳເນີນການ \"%s\" ໃນບ່ອນທີ່ຄວນຈະເປັນຕົວຖືກດຳເນີນການ"

#: src/ui/theme.c:2451
msgid "Coordinate expression had an operand where an operator was expected"
msgstr "ນິພົດພິກັດມີຕົວຖືກດຳເນີນການ ໃນບ່ອນທີ່ຄວນຈະເປັນຕົວດຳເນີນການ"

#: src/ui/theme.c:2459
msgid "Coordinate expression ended with an operator instead of an operand"
msgstr "ນິພົດພິກັດຈົບລົງດ້ວຍຕົວດຳເນີນການ ແທນທີ່ຈະເປັນຕົວຖືກດຳເນີນການ"

#: src/ui/theme.c:2469
#, c-format
msgid ""
"Coordinate expression has operator \"%c\" following operator \"%c\" with no "
"operand in between"
msgstr ""
"ນິພົດພິກັດມີຕົວດຳເນີນການ \"%c\" ຖັດຈາກຕົວດຳເນີນການ \"%c\" ໂດຍບໍ່ມີຕົວຖືກດຳເນີນການຂັ້ນກາງ"

#: src/ui/theme.c:2620 src/ui/theme.c:2665
#, c-format
msgid "Coordinate expression had unknown variable or constant \"%s\""
msgstr "ນິພົດພິກັດມີຕົວປ່ຽນ ຫຼື ຄ່າຄົງທີ່ທີ່ບໍ່ຮູ້ຈັກ \"%s\""

#: src/ui/theme.c:2719
msgid "Coordinate expression parser overflowed its buffer."
msgstr "ຕົວວິເຄາະນິພົດພິກັດເຮັດໃຫ້ບັຟເຟີລົ້ນ."

#: src/ui/theme.c:2748
msgid "Coordinate expression had a close parenthesis with no open parenthesis"
msgstr "ນິພົດພິກັດມີວົງເລັບປິດ ແຕ່ບໍ່ມີວົງເລັບເປີດ"

#: src/ui/theme.c:2812
msgid ""
"Coordinate expression had an open parenthesis with no close parenthesis"
msgstr "ນິພົດພິກັດມີວົງເລັບເປີດ ແຕ່ບໍ່ມີວົງເລັບປິດ"

#: src/ui/theme.c:2823
msgid "Coordinate expression doesn't seem to have any operators or operands"
msgstr "ນິພົດພິກັດເບິ່ງຄືວ່າບໍ່ມີຕົວດຳເນີນການ ຫຼື ຕົວຖືກດຳເນີນການໃດໆ"

#: src/ui/theme.c:3026 src/ui/theme.c:3046 src/ui/theme.c:3066
#, c-format
msgid "Theme contained an expression that resulted in an error: %s\n"
msgstr "ຮູບແບບມີນິພົດທີ່ສົ່ງຜົນໃຫ້ເກີດຂໍ້ຜິດພາດ: %s\n"

#: src/ui/theme.c:4853
#, c-format
msgid ""
"<button function=\"%s\" state=\"%s\" draw_ops=\"whatever\"/> must be "
"specified for this frame style"
msgstr ""
"<button function=\"%s\" state=\"%s\" draw_ops=\"...\"/> ຕ້ອງໄດ້ລະບຸສຳລັບຮູບແບບເຟຣມ"
"ນີ້"

#: src/ui/theme.c:5388 src/ui/theme.c:5413
#, c-format
msgid "Missing <frame state=\"%s\" resize=\"%s\" focus=\"%s\" style=\"whatever\"/>"
msgstr "ຂາດ <frame state=\"%s\" resize=\"%s\" focus=\"%s\" style=\"...\"/>"

#: src/ui/theme.c:5457
#, c-format
msgid "Failed to load theme \"%s\": %s\n"
msgstr "ບໍ່ສາມາດໂຫລດຮູບແບບ \"%s\": %s\n"

#: src/ui/theme.c:5588 src/ui/theme.c:5595 src/ui/theme.c:5602
#: src/ui/theme.c:5609 src/ui/theme.c:5616
#, c-format
msgid "No <%s> set for theme \"%s\""
msgstr "ບໍ່ມີການຕັ້ງ <%s> ສຳລັບຮູບແບບ \"%s\""

#: src/ui/theme.c:5624
#, c-format
msgid ""
"No frame style set for window type \"%s\" in theme \"%s\", add a <window "
"type=\"%s\" style_set=\"whatever\"/> element"
msgstr ""
"ບໍ່ມີການຕັ້ງຮູບແບບເຟຣມສຳລັບປ່ອງຢ້ຽມປະເພດ \"%s\" ໃນຮູບແບບ \"%s\", ກະລຸນາເພີ່ມອົງປະກອບ "
"<window type=\"%s\" style_set=\"...\"/>"

#: src/ui/theme.c:6051 src/ui/theme.c:6113 src/ui/theme.c:6176
#, c-format
msgid "User-defined constants must begin with a capital letter; \"%s\" does not"
msgstr ""
"ຄ່າຄົງທີ່ທີ່ຜູ້ໃຊ້ກຳນົດເອງຕ້ອງເລີ່ມຕົ້ນດ້ວຍຕົວອັກສອນໃຫຍ່; \"%s\" ບໍ່ແມ່ນ"

#: src/ui/theme.c:6059 src/ui/theme.c:6121 src/ui/theme.c:6184
#, c-format
msgid "Constant \"%s\" has already been defined"
msgstr "ຄ່າຄົງທີ່ \"%s\" ຖືກກຳນົດໄວ້ແລ້ວ"

#. Translators: This means that an attribute which should have been found
#. * on an XML element was not in fact found.
#: src/ui/theme-parser.c:253
#, c-format
msgid "No \"%s\" attribute on element <%s>"
msgstr "ບໍ່ມີຄຸນລັກສະນະ \"%s\" ໃນອົງປະກອບ <%s>"

#: src/ui/theme-parser.c:282 src/ui/theme-parser.c:300
#, c-format
msgid "Line %d character %d: %s"
msgstr "ແຖວທີ %d ຕົວອັກສອນທີ %d: %s"

#: src/ui/theme-parser.c:500
#, c-format
msgid "Attribute \"%s\" repeated twice on the same <%s> element"
msgstr "ຄຸນລັກສະນະ \"%s\" ຖືກລະບຸຊ້ຳສອງເທື່ອໃນອົງປະກອບ <%s> ດຽວກັນ"

#: src/ui/theme-parser.c:524 src/ui/theme-parser.c:573
#, c-format
msgid "Attribute \"%s\" is invalid on <%s> element in this context"
msgstr "ຄຸນລັກສະນະ \"%s\" ບໍ່ຖືກຕ້ອງສຳລັບອົງປະກອບ <%s> ໃນບໍລິບົດນີ້"

#: src/ui/theme-parser.c:615
#, c-format
msgid "Could not parse \"%s\" as an integer"
msgstr "ບໍ່ສາມາດວິເຄາະ \"%s\" ເປັນຕົວເລກຖ້ວນ"

#: src/ui/theme-parser.c:624 src/ui/theme-parser.c:679
#, c-format
msgid "Did not understand trailing characters \"%s\" in string \"%s\""
msgstr "ບໍ່ເຂົ້າໃຈຕົວອັກສອນຕາມຫຼັງ \"%s\" ໃນຂໍ້ຄວາມ \"%s\""

#: src/ui/theme-parser.c:634
#, c-format
msgid "Integer %ld must be positive"
msgstr "ຕົວເລກຖ້ວນ %ld ຕ້ອງເປັນຄ່າບວກ"

#: src/ui/theme-parser.c:642
#, c-format
msgid "Integer %ld is too large, current max is %d"
msgstr "ຕົວເລກຖ້ວນ %ld ໃຫຍ່ເກີນໄປ, ຄ່າສູງສຸດປະຈຸບັນແມ່ນ %d"

#: src/ui/theme-parser.c:670 src/ui/theme-parser.c:786
#, c-format
msgid "Could not parse \"%s\" as a floating point number"
msgstr "ບໍ່ສາມາດວິເຄາະ \"%s\" ເປັນຕົວເລກທົດສະນິຍົມ"

#: src/ui/theme-parser.c:701 src/ui/theme-parser.c:729
#, c-format
msgid "Boolean values must be \"true\" or \"false\" not \"%s\""
msgstr "ຄ່າບູລີນ (Boolean) ຕ້ອງເປັນ \"true\" ຫຼື \"false\" ບໍ່ແມ່ນ \"%s\""

#: src/ui/theme-parser.c:756
#, c-format
msgid "Angle must be between 0.0 and 360.0, was %g\n"
msgstr "ມຸມຕ້ອງຢູ່ລະຫວ່າງ 0.0 ແລະ 360.0, ແຕ່ແມ່ນ %g\n"

#: src/ui/theme-parser.c:819
#, c-format
msgid "Alpha must be between 0.0 (invisible) and 1.0 (fully opaque), was %g\n"
msgstr "ຄ່າອັນຟາຕ້ອງຢູ່ລະຫວ່າງ 0.0 (ໂປ່ງໃສ) ແລະ 1.0 (ທຶບແສງ), ແຕ່ແມ່ນ %g\n"

#: src/ui/theme-parser.c:884
#, c-format
msgid ""
"Invalid title scale \"%s\" (must be one of xx-"
"small,x-small,small,medium,large,x-large,xx-large)\n"
msgstr ""
"ຂະໜາດຫົວຂໍ້ \"%s\" ບໍ່ຖືກຕ້ອງ (ຕ້ອງເປັນ xx-small, x-small, small, medium, large, x-"
"large, xx-large)\n"

#: src/ui/theme-parser.c:1040 src/ui/theme-parser.c:1103
#: src/ui/theme-parser.c:1137 src/ui/theme-parser.c:1240
#, c-format
msgid "<%s> name \"%s\" used a second time"
msgstr "ຊື່ \"%s\" ຂອງ <%s> ຖືກໃຊ້ຊ້ຳເປັນເທື່ອທີສອງ"

#: src/ui/theme-parser.c:1052 src/ui/theme-parser.c:1149
#: src/ui/theme-parser.c:1252
#, c-format
