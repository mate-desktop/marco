#: src/core/window.c:6005
#, c-format
msgid ""
"Window %s sets SM_CLIENT_ID on itself, instead of on the WM_CLIENT_LEADER "
"window as specified in the ICCCM.\n"
msgstr ""
"%s терезесі ICCCM ішінде көрсетілгендей WM_CLIENT_LEADER терезесіне орнына, "
"өзіне SM_CLIENT_ID орнатады.\n"

#. We ignore mwm_has_resize_func because WM_NORMAL_HINTS is the
#. * authoritative source for that info. Some apps such as mplayer or
#. * xine disable resize via MWM but not WM_NORMAL_HINTS, but that
#. * leads to e.g. us not fullscreening their windows.  Apps that set
#. * MWM but not WM_NORMAL_HINTS are basically broken. We complain
#. * about these apps but make them work.
#: src/core/window.c:6681
#, c-format
msgid ""
"Window %s sets an MWM hint indicating it isn't resizable, but sets min size "
"%d x %d and max size %d x %d; this doesn't make much sense.\n"
msgstr ""
"%1$s терезесі өлшемі өзгермейтінін білдіретін MWM тұспалын орнатады, бірақ "
"мин. өлшемін %2$d x %3$d және макс. өлшемін %4$d x %5$d етіп орнатады; бұл "
"онша қисынды емес.\n"

