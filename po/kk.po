#: src/50-marco-desktop-key.xml.in:2
msgid "Desktop"
msgstr "Жұмыс үстелі"

#: src/50-marco-desktop-key.xml.in:4
msgid "Show the panel's &quot;Run Application&quot; dialog box"
msgstr "Панельдің &quot;Қолданбаны орындау&quot; сұхбат терезесін көрсету"

#: src/50-marco-desktop-key.xml.in:6 src/org.mate.marco.gschema.xml:634
msgid "Show the panel's main menu"
msgstr "Панельдің негізгі мәзірін көрсету"

#: src/50-marco-desktop-key.xml.in:8 src/org.mate.marco.gschema.xml:644
msgid "Take a screenshot"
msgstr "Скриншотты түсіру"

#: src/50-marco-desktop-key.xml.in:10 src/org.mate.marco.gschema.xml:649
msgid "Take a screenshot of a window"
msgstr "Терезе скриншотын түсіріп алу"

#: src/50-marco-desktop-key.xml.in:12 src/org.mate.marco.gschema.xml:654
msgid "Run a terminal"
msgstr "Терминалды орындау"

#: src/50-marco-desktop-key.xml.in:14 src/org.mate.marco.gschema.xml:659
msgid "Rename current workspace"
msgstr "Ағымдағы жұмыс кеңістігінің атын өзгерту"

#: src/50-marco-global-key.xml.in:2 src/50-marco-window-key.xml.in:2
msgid "Window Management"
msgstr "Терезелерді басқару"

#: src/50-marco-global-key.xml.in:4 src/org.mate.marco.gschema.xml:569
msgid "Move between windows, using a popup window"
msgstr "Қалқымалы терезені пайдаланып, терезелер арасында ауысу"

#: src/50-marco-global-key.xml.in:6 src/org.mate.marco.gschema.xml:559
msgid "Move between windows of an application, using a popup window"
msgstr "Қалқымалы терезені пайдаланып, қолданба терезелері арасында жылжу"

#: src/50-marco-global-key.xml.in:8 src/org.mate.marco.gschema.xml:589
msgid "Move between panels and the desktop, using a popup window"
msgstr ""
"Қалқымалы терезені пайдаланып, панельдер мен жұмыс үстелі арасында жылжу"

#: src/50-marco-global-key.xml.in:10 src/org.mate.marco.gschema.xml:609
msgid "Move between windows immediately"
msgstr "Терезелер арасында бірден жылжу"

#: src/50-marco-global-key.xml.in:12 src/org.mate.marco.gschema.xml:599
msgid "Move between windows of an application immediately"
msgstr "Қолданба терезелері арасында бірден жылжу"

#: src/50-marco-global-key.xml.in:14 src/org.mate.marco.gschema.xml:619
msgid "Move between panels and the desktop immediately"
msgstr "Панельдер мен жұмыс үстелі арасында бірден жылжу"

#: src/50-marco-global-key.xml.in:16 src/org.mate.marco.gschema.xml:629
msgid "Hide all normal windows and set focus to the desktop"
msgstr "Барлық қалыпты терезелерді жасыру және фокусты жұмыс үстеліне беру"

#: src/50-marco-global-key.xml.in:23 src/org.mate.marco.gschema.xml:474
msgid "Switch to workspace 1"
msgstr "1-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:30 src/org.mate.marco.gschema.xml:479
msgid "Switch to workspace 2"
msgstr "2-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:37 src/org.mate.marco.gschema.xml:484
msgid "Switch to workspace 3"
msgstr "3-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:44 src/org.mate.marco.gschema.xml:489
msgid "Switch to workspace 4"
msgstr "4-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:51 src/org.mate.marco.gschema.xml:494
msgid "Switch to workspace 5"
msgstr "5-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:58 src/org.mate.marco.gschema.xml:499
msgid "Switch to workspace 6"
msgstr "6-шы жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:65 src/org.mate.marco.gschema.xml:504
msgid "Switch to workspace 7"
msgstr "7-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:72 src/org.mate.marco.gschema.xml:509
msgid "Switch to workspace 8"
msgstr "8-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:79 src/org.mate.marco.gschema.xml:514
msgid "Switch to workspace 9"
msgstr "9-шы жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:86 src/org.mate.marco.gschema.xml:519
msgid "Switch to workspace 10"
msgstr "10-шы жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:93 src/org.mate.marco.gschema.xml:524
msgid "Switch to workspace 11"
msgstr "11-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:100 src/org.mate.marco.gschema.xml:529
msgid "Switch to workspace 12"
msgstr "12-ші жұмыс орнына ауысу"

#: src/50-marco-global-key.xml.in:107 src/org.mate.marco.gschema.xml:534
msgid "Switch to workspace on the left of the current workspace"
msgstr "Ағымдағы жұмыс кеңістігінің сол жағындағы жұмыс кеңістігіне ауысу"

#: src/50-marco-global-key.xml.in:114 src/org.mate.marco.gschema.xml:539
msgid "Switch to workspace on the right of the current workspace"
msgstr "Ағымдағы жұмыс кеңістігінің оң жағындағы жұмыс кеңістігіне ауысу"

#: src/50-marco-global-key.xml.in:121 src/org.mate.marco.gschema.xml:544
msgid "Switch to workspace above the current workspace"
msgstr "Ағымдағы жұмыс кеңістігінің үстіндегі жұмыс кеңістігіне ауысу"

#: src/50-marco-global-key.xml.in:128 src/org.mate.marco.gschema.xml:549
msgid "Switch to workspace below the current workspace"
msgstr "Ағымдағы жұмыс кеңістігінің астындағы жұмыс кеңістігіне ауысу"

#: src/50-marco-global-key.xml.in:131 src/org.mate.marco.gschema.xml:554
msgid "Switch to previously selected workspace"
msgstr "Алдыңғы таңдалған жұмыс кеңістігіне ауысу"

#: src/50-marco-window-key.xml.in:6 src/org.mate.marco.gschema.xml:740
msgid "Activate the window menu"
msgstr "Терезе мәзірін белсендіру"

#: src/50-marco-window-key.xml.in:10 src/org.mate.marco.gschema.xml:745
msgid "Toggle fullscreen mode"
msgstr "Толық экран режиміне өту/одан шығу"

#: src/50-marco-window-key.xml.in:14 src/org.mate.marco.gschema.xml:750
msgid "Toggle maximization state"
msgstr "Жазық күйін ауыстыру"

#: src/50-marco-window-key.xml.in:18 src/org.mate.marco.gschema.xml:760
msgid "Maximize window"
msgstr "Терезені жазық қылу"

#: src/50-marco-window-key.xml.in:22 src/org.mate.marco.gschema.xml:765
msgid "Restore window"
msgstr "Терезені қалпына келтіру"

#: src/50-marco-window-key.xml.in:26 src/org.mate.marco.gschema.xml:770
msgid "Toggle shaded state"
msgstr "Көлеңкелі күйін ауыстыру"

#: src/50-marco-window-key.xml.in:30 src/org.mate.marco.gschema.xml:780
msgid "Close window"
msgstr "Терезені жабу"

#: src/50-marco-window-key.xml.in:34 src/org.mate.marco.gschema.xml:775
msgid "Minimize window"
msgstr "Терезені минималды қылу"

#: src/50-marco-window-key.xml.in:38 src/org.mate.marco.gschema.xml:785
msgid "Move window"
msgstr "Терезені жылжыту"

#: src/50-marco-window-key.xml.in:42 src/org.mate.marco.gschema.xml:790
msgid "Resize window"
msgstr "Терезе өлшемдерін өзгерту"

#: src/50-marco-window-key.xml.in:50 src/org.mate.marco.gschema.xml:795
msgid "Toggle whether window is on all workspaces or just one"
msgstr ""
"Терезенің барлық жұмыс кеңістіктерінде немесе тек біреуінде болуын ауыстырып "
"қосу"

#: src/50-marco-window-key.xml.in:54 src/org.mate.marco.gschema.xml:880
msgid "Raise window if it's covered by another window, otherwise lower it"
msgstr "Терезені басқа терезе жауып тұрса, оны көтеру, әйтпесе төмен түсіру"

#: src/50-marco-window-key.xml.in:58 src/org.mate.marco.gschema.xml:885
msgid "Raise window above other windows"
msgstr "Терезені басқа терезелердің алдына көтеру"

#: src/50-marco-window-key.xml.in:62 src/org.mate.marco.gschema.xml:890
msgid "Lower window below other windows"
msgstr "Терезені басқа терезелердің артына апару"

#: src/50-marco-window-key.xml.in:66 src/org.mate.marco.gschema.xml:895
msgid "Maximize window vertically"
msgstr "Терезені вертикалды жазық қылу"

#: src/50-marco-window-key.xml.in:70 src/org.mate.marco.gschema.xml:900
msgid "Maximize window horizontally"
msgstr "Терезені горизонталды жазық қылу"

#: src/50-marco-window-key.xml.in:74 src/org.mate.marco.gschema.xml:905
msgid "Tile window to east (right) side of screen"
msgstr "Терезені экранның шығыс (оң) жағына тайлдау"

#: src/50-marco-window-key.xml.in:78 src/org.mate.marco.gschema.xml:910
msgid "Tile window to west (left) side of screen"
msgstr "Терезені экранның батыс (сол) жағына тайлдау"

#: src/50-marco-window-key.xml.in:82
msgid "Tile window to north-west (top left) corner"
msgstr "Терезені солтүстік-батыс (жоғарғы сол) бұрышқа тайлдау"

#: src/50-marco-window-key.xml.in:86
msgid "Tile window to north-east (top right) corner"
msgstr "Терезені солтүстік-шығыс (жоғарғы оң) бұрышқа тайлдау"

#: src/50-marco-window-key.xml.in:90
msgid "Tile window to south-west (bottom left) corner"
msgstr "Терезені оңтүстік-батыс (төменгі сол) бұрышқа тайлдау"

#: src/50-marco-window-key.xml.in:94
msgid "Tile window to south-east (bottom right) corner"
msgstr "Терезені оңтүстік-шығыс (төменгі оң) бұрышқа тайлдау"

#: src/50-marco-window-key.xml.in:98 src/org.mate.marco.gschema.xml:935
msgid "Move window to north-west (top left) corner"
msgstr "Терезені солтүстік-батыс (жоғарғы сол) бұрышқа жылжыту"

#: src/50-marco-window-key.xml.in:102 src/org.mate.marco.gschema.xml:940
msgid "Move window to north-east (top right) corner"
msgstr "Терезені солтүстік-шығыс (жоғарғы оң) бұрышқа жылжыту"

#: src/50-marco-window-key.xml.in:106 src/org.mate.marco.gschema.xml:945
msgid "Move window to south-west (bottom left) corner"
msgstr "Терезені оңтүстік-батыс (төменгі сол) бұрышқа жылжыту"

#: src/50-marco-window-key.xml.in:110 src/org.mate.marco.gschema.xml:950
msgid "Move window to south-east (bottom right) corner"
msgstr "Терезені оңтүстік-шығыс (төменгі оң) бұрышқа жылжыту"

#: src/50-marco-window-key.xml.in:114 src/org.mate.marco.gschema.xml:955
msgid "Move window to north (top) side of screen"
msgstr "Терезені экранның солтүстік (жоғарғы) жағына жылжыту"

#: src/50-marco-window-key.xml.in:118 src/org.mate.marco.gschema.xml:960
msgid "Move window to south (bottom) side of screen"
msgstr "Терезені экранның оңтүстік (төменгі) жағына жылжыту"

#: src/50-marco-window-key.xml.in:122 src/org.mate.marco.gschema.xml:965
msgid "Move window to east (right) side of screen"
msgstr "Терезені экранның шығыс (оң) жағына жылжыту"

#: src/50-marco-window-key.xml.in:126 src/org.mate.marco.gschema.xml:970
msgid "Move window to west (left) side of screen"
msgstr "Терезені экранның батыс (сол) жағына жылжыту"

#: src/50-marco-window-key.xml.in:130 src/org.mate.marco.gschema.xml:975
msgid "Move window to center of screen"
msgstr "Терезені экран ортасына жылжыту"

#: src/50-marco-window-key.xml.in:134 src/org.mate.marco.gschema.xml:980
msgid "Move window to north (top) monitor"
msgstr "Терезені солтүстік (жоғарғы) мониторға жылжыту"

#: src/50-marco-window-key.xml.in:138 src/org.mate.marco.gschema.xml:985
msgid "Move window to south (bottom) monitor"
msgstr "Терезені оңтүстік (төменгі) мониторға жылжыту"

#: src/50-marco-window-key.xml.in:142 src/org.mate.marco.gschema.xml:990
msgid "Move window to east (right) monitor"
msgstr "Терезені шығыс (оң) мониторға жылжыту"

#: src/50-marco-window-key.xml.in:146 src/org.mate.marco.gschema.xml:995
msgid "Move window to west (left) monitor"
msgstr "Терезені батыс (сол) мониторға жылжыту"

#: src/50-marco-window-key.xml.in:154 src/org.mate.marco.gschema.xml:800
msgid "Move window to workspace 1"
msgstr "Терезені 1-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:162 src/org.mate.marco.gschema.xml:805
msgid "Move window to workspace 2"
msgstr "Терезені 2-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:170 src/org.mate.marco.gschema.xml:810
msgid "Move window to workspace 3"
msgstr "Терезені 3-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:178 src/org.mate.marco.gschema.xml:815
msgid "Move window to workspace 4"
msgstr "Терезені 4-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:186 src/org.mate.marco.gschema.xml:820
msgid "Move window to workspace 5"
msgstr "Терезені 5-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:194 src/org.mate.marco.gschema.xml:825
msgid "Move window to workspace 6"
msgstr "Терезені 6-шы жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:202 src/org.mate.marco.gschema.xml:830
msgid "Move window to workspace 7"
msgstr "Терезені 7-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:210 src/org.mate.marco.gschema.xml:835
msgid "Move window to workspace 8"
msgstr "Терезені 8-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:218 src/org.mate.marco.gschema.xml:840
msgid "Move window to workspace 9"
msgstr "Терезені 9-шы жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:226 src/org.mate.marco.gschema.xml:845
msgid "Move window to workspace 10"
msgstr "Терезені 10-шы жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:234 src/org.mate.marco.gschema.xml:850
msgid "Move window to workspace 11"
msgstr "Терезені 11-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:242 src/org.mate.marco.gschema.xml:855
msgid "Move window to workspace 12"
msgstr "Терезені 12-ші жұмыс орнына жылжыту"

#: src/50-marco-window-key.xml.in:250 src/org.mate.marco.gschema.xml:860
msgid "Move window one workspace to the left"
msgstr "Терезені бір жұмыс орнына солға жылжыту"

#: src/50-marco-window-key.xml.in:258 src/org.mate.marco.gschema.xml:865
msgid "Move window one workspace to the right"
msgstr "Терезені бір жұмыс орнына оңға жылжыту"

#: src/50-marco-window-key.xml.in:266 src/org.mate.marco.gschema.xml:870
msgid "Move window one workspace up"
msgstr "Терезені бір жұмыс орнына жоғары жылжыту"

#: src/50-marco-window-key.xml.in:274 src/org.mate.marco.gschema.xml:875
msgid "Move window one workspace down"
msgstr "Терезені бір жұмыс орнына төмен жылжыту"

#: src/org.mate.marco.gschema.xml:50
msgid "Modifier to use for modified window click actions"
msgstr "Терезені шертудің өзгертілген әрекеттері үшін қолданылатын модификатор"

#: src/org.mate.marco.gschema.xml:51
msgid ""
"Clicking a window while holding down this modifier key will move the window "
"(left click), resize the window (middle click), or show the window menu "
"(right click). The middle and right click operations may be swapped using "
"the \"resize_with_right_button\" key. Modifier is expressed as \"<Alt>\" or "
"\"<Super>\" for example."
msgstr ""
"Осы модификатор пернесін басып тұрып терезеге шерту терезені жылжытады (сол "
"жақпен шерту), өлшемін өзгертеді (ортаңғы шерту) немесе терезе мәзірін "
"көрсетеді (оң жақпен шерту). Ортаңғы және оң жақ шерту операцияларын "
"\"resize_with_right_button\" кілті арқылы ауыстыруға болады. Мысалы, "
"модификатор \"<Alt>\" немесе \"<Super>\" түрінде көрсетіледі."

#: src/org.mate.marco.gschema.xml:55
msgid "Whether to resize with the right button"
msgstr "Оң жақ батырмасымен өлшемін өзгерту керек пе"

#: src/org.mate.marco.gschema.xml:56
msgid ""
"Set this to true to resize with the right button and show a menu with the "
"middle button while holding down the key given in \"mouse_button_modifier\";"
" set it to false to make it work the opposite way around."
msgstr ""
"\"mouse_button_modifier\" кілтінде берілген пернені басып тұрып, оң жақ "
"батырмамен өлшемін өзгерту және ортаңғы батырмамен мәзірді көрсету үшін "
"осыны ақиқат мәніне орнатыңыз; керісінше жұмыс істеуі үшін жалған мәніне "
"орнатыңыз."

#: src/org.mate.marco.gschema.xml:60
msgid "Whether to display preselected tab window border"
msgstr "Алдын ала таңдалған бет терезесінің шекарасын көрсету керек пе"

#: src/org.mate.marco.gschema.xml:61
msgid ""
"Set this to false to disable border of preselected window while performing "
"tab switching."
msgstr ""
"Беттерді ауыстыру кезінде алдын ала таңдалған терезенің шекарасын сөндіру "
"үшін осыны жалған мәніне орнатыңыз."

#: src/org.mate.marco.gschema.xml:65
msgid "Arrangement of buttons on the titlebar"
msgstr "Атау жолағындағы батырмалар орналасуы"

#: src/org.mate.marco.gschema.xml:66
msgid ""
"Arrangement of buttons on the titlebar. The value should be a string, such "
"as \"menu:minimize,maximize,spacer,close\"; the colon separates the left "
"corner of the window from the right corner, and the button names are comma-"
"separated. Duplicate buttons are not allowed. Unknown button names are "
"silently ignored so that buttons can be added in future marco versions "
"without breaking older versions. A special spacer tag can be used to insert "
"some space between two adjacent buttons."
msgstr ""
"Атаулар жолағындағы батырмалардың орналасу реті. Мәні "
"\"menu:minimize,maximize,spacer,close\" сияқты жол болуы керек; қос нүкте "
"терезенің сол жақ бұрышын оң жақ бұрышынан ажыратады, ал батырмалардың "
"атаулары үтірмен бөлінеді. Батырмалардың көшірмелерін жасауға рұқсат "
"етілмейді. Ескі нұсқаларды бұзбай болашақ marco нұсқаларында батырмалар қосу "
"мүмкіндігі болуы үшін белгісіз батырма аттары үнсіз еленбейді. Екі іргелес "
"батырма арасына біраз орын кірістіру үшін арнайы spacer тегін пайдалануға "
"болады."

#: src/org.mate.marco.gschema.xml:70
msgid "Window focus mode"
msgstr "Фокус режимі"

#: src/org.mate.marco.gschema.xml:71
msgid ""
"The window focus mode indicates how windows are activated. It has three "
"possible values; \"click\" means windows must be clicked in order to focus "
"them, \"sloppy\" means windows are focused when the mouse enters the window,"
" and \"mouse\" means windows are focused when the mouse enters the window "
"and unfocused when the mouse leaves the window."
msgstr ""
"Терезе фокусының режимі терезелердің қалай белсендірілетінін көрсетеді. Оның "
"үш мүмкін мәні бар; \"click\" терезелерге фокус беру үшін оларды шерту "
"керектігін білдіреді, \"sloppy\" тышқан терезеге кірген кезде терезеге фокус "
"берілетінін білдіреді, ал \"mouse\" тышқан терезеге кіргенде оған фокус "
"беріліп, тышқан терезеден шыққанда фокустан шығарылатынын білдіреді."

#: src/org.mate.marco.gschema.xml:75
msgid "Control how new windows get focus"
msgstr "Жаңа терезелердің фокус алуын басқару"

#: src/org.mate.marco.gschema.xml:76
msgid ""
"This option provides additional control over how newly created windows get "
"focus. It has two possible values; \"smart\" applies the user's normal focus"
" mode, and \"strict\" results in windows started from a terminal not being "
"given focus."
msgstr ""
"Бұл опция жаңадан жасалған терезелердің фокус алуын қосымша басқаруды "
"қамтамасыз етеді. Оның екі мүмкін мәні бар; \"smart\" пайдаланушының қалыпты "
"фокус режимін қолданады, ал \"strict\" терминалдан іске қосылған терезелерге "
"фокус берілмеуіне әкеледі."

#: src/org.mate.marco.gschema.xml:80
msgid "Whether raising should be a side-effect of other user interactions"
msgstr ""
"Көтеру пайдаланушының басқа өзара әрекеттесулерінің жанама эффектісі болуы "
"керек пе"

#: src/org.mate.marco.gschema.xml:81
msgid ""
"Setting this option to false can lead to buggy behavior, so users are "
"strongly discouraged from changing it from the default of true. Many actions"
" (e.g. clicking in the client area, moving or resizing the window) normally "
"raise the window as a side-effect. Setting this option to false, which is "
"strongly discouraged, will decouple raising from other user actions, and "
"ignore raise requests generated by applications. See "
"http://bugzilla.gnome.org/show_bug.cgi?id=445447#c6. Even when this option "
"is false, windows can still be raised by an alt-left-click anywhere on the "
"window, a normal click on the window decorations, or by special messages "
"from pagers, such as activation requests from tasklist applets. This option "
"is currently disabled in click-to-focus mode. Note that the list of ways to "
"raise windows when raise_on_click is false does not include programmatic "
"requests from applications to raise windows; such requests will be ignored "
"regardless of the reason for the request. If you are an application "
"developer and have a user complaining that your application does not work "
"with this setting disabled, tell them it is _their_ fault for breaking their"
" window manager and that they need to change this option back to true or "
"live with the \"bug\" they requested."
msgstr ""
"Бұл опцияны жалған мәніне орнату қателіктерге әкелуі мүмкін, сондықтан "
"пайдаланушыларға оны әдепкі ақиқат мәнінен өзгертпеу қатаң түрде ұсынылады. "
"Көптеген әрекеттер (мысалы, клиент аймағын шерту, терезені жылжыту немесе "
"өлшемін өзгерту) әдетте жанама эффект ретінде терезені көтереді. Бұл опцияны "
"жалған етіп орнату (бұл ұсынылмайды) көтеруді басқа пайдаланушы "
"әрекеттерінен ажыратады және қолданбалар жасаған көтеру сұрауларын елемейді. "
"http://bugzilla.gnome.org/show_bug.cgi?id=445447#c6 қараңыз. Тіпті осы опция "
"жалған болғанның өзінде, терезелерді терезенің кез келген жерін alt-сол "
"жақпен шерту, терезе безендірулеріне қалыпты шерту немесе пейджерлердің "
"арнайы хабарламалары арқылы (мысалы, тапсырмалар тізімі апплеттерінің "
"белсендіру сұраулары) көтеруге болады. Бұл опция қазіргі уақытта шерту "
"арқылы фокустау режимінде сөндірілген. Ескеріңіз: raise_on_click жалған "
"болған кезде терезелерді көтеру тәсілдерінің тізімі қолданбалардың "
"терезелерді көтеру жөніндегі бағдарламалық сұрауларын қамтымайды; мұндай "
"сұраулар сұрау себебіне қарамастан еленбейді. Егер сіз қолданба әзірлеушісі "
"болсаңыз және пайдаланушы қолданбаңыз осы баптау сөндірілген кезде жұмыс "
"істемейтініне шағымданса, оларға терезелер басқарушысын бұзғаны үшін "
"_өздері_ кінәлі екенін және бұл опцияны қайтадан ақиқат мәніне өзгертуі "
"немесе өздері сұраған «қателікпен» өмір сүруі керектігін айтыңыз."

#: src/org.mate.marco.gschema.xml:85
msgid "Action on title bar double-click"
msgstr "Атаулар жолағын қос шерткен кездегі әрекет"

#: src/org.mate.marco.gschema.xml:86
msgid ""
"This option determines the effects of double-clicking on the title bar. "
"Current valid options are 'toggle_shade', which will shade/unshade the "
"window, 'toggle_maximize' which will maximize/unmaximize the window, "
"'toggle_maximize_horizontally' and 'toggle_maximize_vertically' which will "
"maximize/unmaximize the window in that direction only, 'minimize' which will"
" minimize the window, 'shade' which will roll the window up, 'menu' which "
"will display the window menu, 'lower' which will put the window behind all "
"the others, and 'none' which will not do anything."
msgstr ""
"Бұл опция атаулар жолағын қос шертудің нәтижелерін анықтайды. Ағымдағы "
"жарамды опциялар: терезені көлеңкелейтін/көлеңкелеуден шығаратын "
"'toggle_shade', терезені жазатын/жазудан шығаратын 'toggle_maximize', "
"терезені тек сол бағытта жазатын/жазудан шығаратын "
"'toggle_maximize_horizontally' және 'toggle_maximize_vertically', терезені "
"қайыратын 'minimize', терезені шиыршықтайтын 'shade', терезе мәзірін "
"көрсететін 'menu', терезені басқалардың артына қоятын 'lower' және ешнәрсе "
"істемейтін 'none'."

#: src/org.mate.marco.gschema.xml:90
msgid "Action on title bar middle-click"
msgstr "Атаулар жолағын ортаңғы батырмамен шерткен кездегі әрекет"

#: src/org.mate.marco.gschema.xml:91
msgid ""
"This option determines the effects of middle-clicking on the title bar. "
"Current valid options are 'toggle_shade', which will shade/unshade the "
"window, 'toggle_maximize' which will maximize/unmaximize the window, "
"'toggle_maximize_horizontally' and 'toggle_maximize_vertically' which will "
"maximize/unmaximize the window in that direction only, 'minimize' which will"
" minimize the window, 'shade' which will roll the window up, 'menu' which "
"will display the window menu, 'lower' which will put the window behind all "
"the others, and 'none' which will not do anything."
msgstr ""
"Бұл опция атаулар жолағын ортаңғы батырмамен шертудің нәтижелерін анықтайды. "
"Ағымдағы жарамды опциялар: терезені көлеңкелейтін/көлеңкелеуден шығаратын "
"'toggle_shade', терезені жазатын/жазудан шығаратын 'toggle_maximize', "
"терезені тек сол бағытта жазатын/жазудан шығаратын "
"'toggle_maximize_horizontally' және 'toggle_maximize_vertically', терезені "
"қайыратын 'minimize', терезені шиыршықтайтын 'shade', терезе мәзірін "
"көрсететін 'menu', терезені басқалардың артына қоятын 'lower' және ешнәрсе "
"істемейтін 'none'."

#: src/org.mate.marco.gschema.xml:95
msgid "Action on title bar right-click"
msgstr "Атаулар жолағын оң жақпен шерткен кездегі әрекет"

#: src/org.mate.marco.gschema.xml:96
msgid ""
"This option determines the effects of right-clicking on the title bar. "
"Current valid options are 'toggle_shade', which will shade/unshade the "
"window, 'toggle_maximize' which will maximize/unmaximize the window, "
"'toggle_maximize_horizontally' and 'toggle_maximize_vertically' which will "
"maximize/unmaximize the window in that direction only, 'minimize' which will"
" minimize the window, 'shade' which will roll the window up, 'menu' which "
"will display the window menu, 'lower' which will put the window behind all "
"the others, and 'none' which will not do anything."
msgstr ""
"Бұл опция атаулар жолағын оң жақпен шертудің нәтижелерін анықтайды. Ағымдағы "
"жарамды опциялар: терезені көлеңкелейтін/көлеңкелеуден шығаратын "
"'toggle_shade', терезені жазатын/жазудан шығаратын 'toggle_maximize', "
"терезені тек сол бағытта жазатын/жазудан шығаратын "
"'toggle_maximize_horizontally' және 'toggle_maximize_vertically', терезені "
"қайыратын 'minimize', терезені шиыршықтайтын 'shade', терезе мәзірін "
"көрсететін 'menu', терезені басқалардың артына қоятын 'lower' және ешнәрсе "
"істемейтін 'none'."

#: src/org.mate.marco.gschema.xml:100
msgid "Automatically raises the focused window"
msgstr "Фокусталған терезені автоматты түрде көтереді"

#: src/org.mate.marco.gschema.xml:101
msgid ""
"If set to true, and the focus mode is either \"sloppy\" or \"mouse\" then "
"the focused window will be automatically raised after a delay specified by "
"the auto_raise_delay key. This is not related to clicking on a window to "
"raise it, nor to entering a window during drag-and-drop."
msgstr ""
"Егер ақиқат мәніне орнатылса және фокус режимі \"sloppy\" немесе \"mouse\" "
"болса, фокусталған терезе auto_raise_delay кілтімен көрсетілген кідірістен "
"кейін автоматты түрде көтеріледі. Бұл терезені көтеру үшін оны шертуге де, "
"сүйреп апарып тастау кезінде терезеге кіруге де қатысты емес."

#: src/org.mate.marco.gschema.xml:105
msgid "Delay in milliseconds for the auto raise option"
msgstr "Автоматты түрде көтеру опциясы үшін миллисекундпен берілген кідіріс"

#: src/org.mate.marco.gschema.xml:106
msgid ""
"The time delay before raising a window if auto_raise is set to true. The "
"delay is given in thousandths of a second."
msgstr ""
"Егер auto_raise ақиқат деп орнатылса, терезені көтеру алдындағы уақыт "
"кідірісі. Кідіріс секундтың мыңнан бір бөлігімен беріледі."

#: src/org.mate.marco.gschema.xml:110
msgid "Current theme"
msgstr "Ағымдағы тема"

#: src/org.mate.marco.gschema.xml:111
msgid ""
"The theme determines the appearance of window borders, titlebar, and so "
"forth."
msgstr ""
"Тема терезе шекараларының, атаулар жолағының және т.б. сыртқы көрінісін "
"анықтайды."

#: src/org.mate.marco.gschema.xml:115
msgid "Use standard system font in window titles"
msgstr "Терезе атауларында стандартты жүйелік қаріпті пайдалану"

#: src/org.mate.marco.gschema.xml:116
msgid ""
"If true, ignore the titlebar_font option, and use the standard application "
"font for window titles."
msgstr ""
"Егер ақиқат болса, titlebar_font опциясын елемей, терезе атаулары үшін "
"стандартты қолданба қарпін пайдаланыңыз."

#: src/org.mate.marco.gschema.xml:120
msgid "Window title font"
msgstr "Терезе атауының қарібі"

#: src/org.mate.marco.gschema.xml:121
msgid ""
"A font description string describing a font for window titlebars. The size "
"from the description will only be used if the titlebar_font_size option is "
"set to 0. Also, this option is disabled if the titlebar_uses_desktop_font "
"option is set to true."
msgstr ""
"Терезенің атаулар жолағына арналған қаріпті сипаттайтын қаріп сипаттамасының "
"жолы. Сипаттамадағы өлшем тек titlebar_font_size опциясы 0 мәніне орнатылған "
"кезде ғана пайдаланылады. Сондай-ақ, егер titlebar_uses_desktop_font опциясы "
"ақиқат мәніне орнатылса, бұл опция сөндіріледі."

#: src/org.mate.marco.gschema.xml:126
msgid "Number of workspaces"
msgstr "Жұмыс орындар саны"

#: src/org.mate.marco.gschema.xml:127
msgid ""
"Number of workspaces. Must be more than zero, and has a fixed maximum to "
"prevent making the desktop unusable by accidentally asking for too many "
"workspaces."
msgstr ""
"Жұмыс кеңістіктерінің саны. Нөлден көп болуы тиіс және тым көп жұмыс "
"кеңістігін абайсызда сұрау арқылы жұмыс үстелін жарамсыз етуді болдырмау "
"үшін бекітілген максимумге ие."

#: src/org.mate.marco.gschema.xml:131
msgid "Workspace wrap style"
msgstr "Жұмыс кеңістігін ауыстыру стилі"

#: src/org.mate.marco.gschema.xml:132
msgid ""
"The wrap style is used to determine how to switch from one workspace to "
"another at the border of the workspace switcher. When set to \"no wrap\", "
"nothing will happen if you try to switch to a workspace past the border of "
"the workspace switcher. If set to \"classic\", the old marco behavior is "
"used: the end of one row leads to the beginning of the next and the end of a"
" column leads to the beginning of the next. If set to \"toroidal\", "
"workspaces are connected like a doughnut: the end of each row leads to its "
"own beginning and the end of each column leads to its own beginning."
msgstr ""
"Ауыстыру стилі жұмыс кеңістігін ауыстырғыш шекарасында бір жұмыс "
"кеңістігінен екіншісіне қалай ауысу керектігін анықтау үшін қолданылады. "
"\"no wrap\" күйіне орнатылған кезде, жұмыс кеңістігі ауыстырғышының "
"шекарасынан асып түсетін жұмыс кеңістігіне ауысуға әрекет жасасаңыз, ештеңе "
"болмайды. \"classic\" күйіне орнатылған кезде, ескі marco әрекеті "
"пайдаланылады: бір жолдың соңы келесі жолдың басына, ал бағанның соңы келесі "
"бағанның басына апарады. \"toroidal\" күйіне орнатылған кезде, жұмыс "
"кеңістіктері тороид тәрізді жалғасады: әрбір жолдың соңы өз басына, ал әрбір "
"бағанның соңы өз басына апарады."

#: src/org.mate.marco.gschema.xml:136
msgid "Enable Visual Bell"
msgstr "Визуалды қоңырауды іске қосу"

#: src/org.mate.marco.gschema.xml:137
msgid ""
"Turns on a visual indication when an application or the system issues a "
"'bell' or 'beep'; useful for the hard-of-hearing and for use in noisy "
"environments."
msgstr ""
"Қолданба немесе жүйе 'bell' немесе 'beep' дабылын берген кезде визуалды "
"көрсеткішті іске қосады; есту қабілеті нашар адамдар мен шулы орталарда "
"пайдалануға ыңғайлы."

#: src/org.mate.marco.gschema.xml:141
msgid "System Bell is Audible"
msgstr "Жүйелік қоңырау естіледі"

#: src/org.mate.marco.gschema.xml:142
msgid ""
"Determines whether applications or the system can generate audible 'beeps'; "
"may be used in conjunction with 'visual bell' to allow silent 'beeps'."
msgstr ""
"Қолданбалардың немесе жүйенің дыбыстық 'beep' белгілерін шығара алатынын "
"анықтайды; дыбыссыз 'beep' белгілеріне рұқсат ету үшін 'visual bell' "
"мүмкіндігімен бірге пайдаланылуы мүмкін."

#: src/org.mate.marco.gschema.xml:146
msgid "Visual Bell Type"
msgstr "Визуалды қоңырау түрі"

#: src/org.mate.marco.gschema.xml:147
msgid ""
"Tells Marco how to implement the visual indication that the system bell or "
"another application 'bell' indicator has been rung. Currently there are two "
"valid values, \"fullscreen\", which causes a fullscreen white-black flash, "
"and \"frame_flash\" which causes the titlebar of the application which sent "
"the bell signal to flash. If the application which sent the bell is unknown "
"(as is usually the case for the default \"system beep\"), the currently "
"focused window's titlebar is flashed."
msgstr ""
"Жүйелік қоңырау немесе басқа қолданбаның 'bell' индикаторы ойналған кезде "
"визуалды көрсеткішті қалай жүзеге асыру керектігін Marco-ға хабарлайды. "
"Қазіргі уақытта екі жарамды мән бар: толық экранды ақ-қара жыпылықтауды "
"тудыратын \"fullscreen\" және қоңырау сигналын жіберген қолданбаның атаулар "
"жолағының жыпылықтауына әкелетін \"frame_flash\". Егер қоңырауды жіберген "
"қолданба белгісіз болса (әдетте әдепкі \"system beep\" үшін болатындай), "
"ағымдағы фокусталған терезенің атаулар жолағы жыпылықтайды."

#: src/org.mate.marco.gschema.xml:151
msgid "Compositing Manager"
msgstr "Композитинг баптаулары"

#: src/org.mate.marco.gschema.xml:152
msgid "Determines whether Marco is a compositing manager."
msgstr "Marco композитинг басқарушысы болып табылатынын анықтайды."

#: src/org.mate.marco.gschema.xml:156
msgid "Fast Alt-Tab with compositing manager (disable thumbnails)"
msgstr "Композитинг басқарушысы бар жылдам Alt-Tab (нобайларды сөндіру)"

#: src/org.mate.marco.gschema.xml:157
msgid ""
"If set to true, no window thumbnails will be displayed in the alt-tab popup "
"window when the compositing manager is enabled. Application icons will be "
"displayed instead. Note that on high resolution screens with many visible "
"windows there can be a perceptible lag in rendering."
msgstr ""
"Егер ақиқат мәніне орнатылса, композитинг басқарушысы іске қосылған кезде "
"alt-tab қалқымалы терезесінде терезе нобайлары көрсетілмейді. Оның орнына "
"қолданба таңбашалары көрсетіледі. Көптеген көрінетін терезелері бар жоғары "
"ажыратымдылықты экрандарда рендерингте байқалатын кідіріс болуы мүмкін "
"екенін ескеріңіз."

#: src/org.mate.marco.gschema.xml:161
msgid "If true, trade off usability for less resource usage"
msgstr ""
"Егер ақиқат болса, ресурстарды аз пайдалану үшін ыңғайлылықтан бас тарту"

#: src/org.mate.marco.gschema.xml:162
msgid ""
"If true, marco will give the user less feedback by using wireframes, "
"avoiding animations, or other means. This is a significant reduction in "
"usability for many users, but may allow legacy applications to continue "
"working, and may also be a useful tradeoff for terminal servers. However, "
"the wireframe feature is disabled when accessibility is on."
msgstr ""
"Егер ақиқат болса, marco сымдық қаңқаларды пайдалану, анимацияларды "
"болдырмау немесе басқа құралдар арқылы пайдаланушыға кері байланысты азырақ "
"береді. Бұл көптеген пайдаланушылар үшін ыңғайлылықтың айтарлықтай "
"төмендеуіне әкеледі, бірақ ескі қолданбалардың жұмысын жалғастыруына "
"мүмкіндік береді және терминалдық серверлер үшін пайдалы шешім болуы мүмкін. "
"Алайда, арнайы мүмкіндіктер қосулы болған кезде сымдық қаңқа мүмкіндігі "
"сөндіріледі."

#: src/org.mate.marco.gschema.xml:166
msgid ""
"(Not implemented) Navigation works in terms of applications not windows"
msgstr ""
"(Іске асырылмаған) Навигация терезелер бойынша емес, қолданбалар бойынша "
"жұмыс істейді"

#: src/org.mate.marco.gschema.xml:167
msgid ""
"If true, then Marco works in terms of applications rather than windows. The "
"concept is a bit abstract, but in general an application-based setup is more"
" like the Mac and less like Windows. When you focus a window in application-"
"based mode, all the windows in the application will be raised. Also, in "
"application-based mode, focus clicks are not passed through to windows in "
"other applications. Application-based mode is, however, largely "
"unimplemented at the moment."
msgstr ""
"Егер ақиқат болса, Marco терезелерден гөрі қолданбалар бойынша жұмыс "
"істейді. Тұжырымдамасы біршама абстрактілі, бірақ жалпы алғанда қолданбаға "
"негізделген орнату көбінесе Mac-қа ұқсас және Windows-қа азырақ ұқсайды. "
"Қолданбаға негізделген режимде терезеге фокустаған кезде, сол қолданбадағы "
"барлық терезелер көтеріледі. Сондай-ақ, қолданбаға негізделген режимде "
"фокустау шертулері басқа қолданбалардың терезелеріне жіберілмейді. Алайда "
"қазіргі уақытта қолданбаға негізделген режим негізінен жүзеге асырылмаған."

#: src/org.mate.marco.gschema.xml:171
msgid "Disable misfeatures that are required by old or broken applications"
msgstr ""
"Ескі немесе бұзылған қолданбалар талап ететін қате мүмкіндіктерді сөндіру"

#: src/org.mate.marco.gschema.xml:172
msgid ""
"Some applications disregard specifications in ways that result in window "
"manager misfeatures. This option puts Marco in a rigorously correct mode, "
"which gives a more consistent user interface, provided one does not need to "
"run any misbehaving applications."
msgstr ""
"Кейбір қолданбалар спецификацияларды ескермейді, бұл терезе басқарушысының "
"қате жұмыс істеуіне әкеледі. Бұл опция Marco-ны қатаң дұрыс режимге "
"келтіреді, бұл дұрыс жұмыс істемейтін қолданбаларды орындаудың қажеті "
"болмаған жағдайда біркелкі пайдаланушы интерфейсін қамтамасыз етеді."

#: src/org.mate.marco.gschema.xml:176
msgid "Determines if new windows are created on the center of the screen"
msgstr "Жаңа терезелер экранның ортасында жасалатынын анықтайды"

#: src/org.mate.marco.gschema.xml:177
msgid ""
"If set to true, new windows are opened in the center of the screen. "
"Otherwise, they are opened at the top left of the screen."
msgstr ""
"Егер ақиқат мәніне орнатылса, жаңа терезелер экранның ортасында ашылады. "
"Әйтпесе, олар экранның жоғарғы сол жағында ашылады."

#: src/org.mate.marco.gschema.xml:181
msgid "Whether to enable window tiling"
msgstr "Терезелерді тайлдауды іске қосу керек пе"

#: src/org.mate.marco.gschema.xml:182
msgid ""
"If enabled, dropping windows on screen edges maximizes them vertically and "
"resizes them horizontally to cover half of the available area. Drag-dropping"
" to the top maximizes the window if allow-top-tiling is enabled."
msgstr ""
"Егер іске қосылса, терезелерді экран жиектеріне тастау оларды вертикалды "
"түрде жазады және қолжетімді ауданның жартысын жабу үшін олардың өлшемін "
"горизонталды түрде өзгертеді. Егер allow-top-tiling іске қосылған болса, "
"жоғарыға сүйреп тастау терезені жазады."

#: src/org.mate.marco.gschema.xml:186
msgid "Whether to maximize the window when dragged to the top of the screen"
msgstr "Терезені экранның жоғарғы жағына сүйреген кезде жазу керек пе"

#: src/org.mate.marco.gschema.xml:187
msgid ""
"If enabled, drag-dropping a window to the top of the screen will maximize "
"it. Only works when allow-tiling is enabled."
msgstr ""
"Егер іске қосылса, терезені экранның жоғарғы жағына сүйреп тастау оны "
"жазады. Тек allow-tiling іске қосылған кезде ғана жұмыс істейді."

#: src/org.mate.marco.gschema.xml:191
msgid "Whether to enable cycling through different tile sizes"
msgstr "Әртүрлі тайл өлшемдері арасында ауысып отыруды іске қосу керек пе"

#: src/org.mate.marco.gschema.xml:192
msgid ""
"If enabled, tiling a window will cycle through multiple different sizes by "
"using the same keyboard shortcut multiple times in a row."
msgstr ""
"Егер іске қосылса, терезені тайлдау бір пернетақта жарлығын қатарынан "
"бірнеше рет пайдалану арқылы бірнеше түрлі өлшемдерді кезекпен ауыстырады."

#: src/org.mate.marco.gschema.xml:196
msgid "Window placement mode"
msgstr "Терезені орналастыру режимі"

#: src/org.mate.marco.gschema.xml:197
msgid ""
"The window placement mode indicates how new windows are positioned. "
"\"automatic\" means the system chooses a location automatically based on the"
" space available on the desktop, or by a simple cascade if there is no "
"space; \"pointer\" means that new windows are placed according to the mouse "
"pointer position; \"manual\" means that the user must manually place the new"
" window with the mouse or keyboard."
msgstr ""
"Терезені орналастыру режимі жаңа терезелердің қалай орналастырылатынын "
"көрсетеді. \"automatic\" жүйе жұмыс үстеліндегі бос орын негізінде автоматты "
"түрде орын таңдайтынын немесе орын болмаса, қарапайым каскадты қолданатынын "
"білдіреді; \"pointer\" жаңа терезелер тышқан курсорының орнына сәйкес "
"орналастырылатынын білдіреді; \"manual\" пайдаланушы жаңа терезені тышқанмен "
"немесе пернетақтамен қолмен орналастыруы керек дегенді білдіреді."

#: src/org.mate.marco.gschema.xml:201
msgid "List of applications ignored by show-desktop"
msgstr "show-desktop арқылы еленбейтін қолданбалар тізімі"

#: src/org.mate.marco.gschema.xml:202
msgid ""
"Comma separated class list. Each running GUI application referenced to given"
" windows manager class will be ignored by 'Show Desktop' functionality."
msgstr ""
"Үтірмен бөлінген класстар тізімі. Берілген терезелер басқарушысының класына "
"сілтеме жасайтын әрбір орындалып жатқан GUI қолданбасы «Жұмыс үстелін көрсету"
"» функциясы арқылы еленбейді."

#: src/org.mate.marco.gschema.xml:207
msgid "Icon size in alt-tab popup window"
msgstr "alt-tab қалқымалы терезесіндегі таңбаша өлшемі"

#: src/org.mate.marco.gschema.xml:208
msgid ""
"Size of the application icons displayed in alt-tab popup window. The "
"screen's scale factor is applied to this value."
msgstr ""
"alt-tab қалқымалы терезесінде көрсетілген қолданба таңбашаларының өлшемі. "
"Экранның масштабтау коэффициенті осы мәнге қолданылады."

#: src/org.mate.marco.gschema.xml:213
msgid "Maximum number of columns in alt-tab popup window"
msgstr "alt-tab қалқымалы терезесіндегі бағандардың максималды саны"

#: src/org.mate.marco.gschema.xml:214
msgid ""
"The popup window will be expanded to fit up to these many entries per row."
msgstr ""
"Қалқымалы терезе әр жолға осы сандағы элементтерді сыйдыру үшін кеңейтіледі."

#: src/org.mate.marco.gschema.xml:218
msgid "Expand the alt-tab popup window to fit longer window titles"
msgstr ""
"Ұзағырақ терезе атауларын сыйдыру үшін alt-tab қалқымалы терезесін кеңейту"

#: src/org.mate.marco.gschema.xml:219
msgid ""
"The popup window may be expanded up to the width determined by the config "
"parameter 'alt-tab-max-columns'."
msgstr ""
"Қалқымалы терезе 'alt-tab-max-columns' конфигурациялық параметрімен "
"анықталған енге дейін кеңейтілуі мүмкін."

#: src/org.mate.marco.gschema.xml:223
msgid "Raise windows to surface while cycling alt-tab popup"
msgstr ""
"alt-tab қалқымалы терезесін ауыстыру кезінде терезелерді алдыңғы планға "
"көтеру"

#: src/org.mate.marco.gschema.xml:224
msgid ""
"While using the popup window, selected windows will be raised to make them "
"easy to identify."
msgstr ""
"Қалқымалы терезені пайдалану кезінде таңдалған терезелер оларды оңай анықтау "
"үшін көтеріледі."

